+
+    function setCompareRange(range) {
+        currentRange = range;
+        ['1m','3m','6m'].forEach(function(r) {
+            var btn = document.getElementById('btn_' + r);
+            btn.style.background = r === range ? '#0073aa' : '';
+            btn.style.color      = r === range ? '#fff' : '';
+        });
+        renderCompareChart();
